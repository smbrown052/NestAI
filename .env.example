# .env.example — NestAI environment variables
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control — it contains real secrets.
#
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (Docker Compose):
DATABASE_URL=postgresql+psycopg2://nestai:change_me@localhost:5432/nestai
POSTGRES_PASSWORD=change_me

# ── First admin account bootstrap ─────────────────────────────────────────────
# Used only once to create the first admin via:
#   python -m app.cli.seed_admin
# Remove or blank these after the account is created.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# ── FastAPI ───────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_string
# Generate a unique signing key in approved secret storage; never reuse examples.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
NESTAI_OWNER_EMAIL=owner@example.com
ENVIRONMENT=development
# Set to "true" to log all SQL queries (noisy, useful for debugging)
SQL_ECHO=false

# ── Frontend ─────────────────────────────────────────────────────────────────
# Used by the Streamlit app for API calls during local development.
NESTAI_API_BASE_URL=http://127.0.0.1:8001

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Walk Score ────────────────────────────────────────────────────────────────
WALKSCORE_API_KEY=

# ── Stripe (backend only; sandbox credentials for tests) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_PLUS_PRICE_ID=
NESTAI_STREAMLIT_URL=http://127.0.0.1:8501

# ── Separate paid monthly quotas (shared across apartments/houses; UTC) ───────
NESTAI_QUOTA_PREMIUM_AI=100
NESTAI_QUOTA_PREMIUM_ENRICHMENT=50
NESTAI_QUOTA_PREMIUM_COMMUTE=100
NESTAI_QUOTA_PREMIUM_REPORTS=20
NESTAI_QUOTA_PREMIUM_PLUS_AI=500
NESTAI_QUOTA_PREMIUM_PLUS_ENRICHMENT=200
NESTAI_QUOTA_PREMIUM_PLUS_COMMUTE=400
NESTAI_QUOTA_PREMIUM_PLUS_REPORTS=100

# ── Isolated regression infrastructure; never a production database ──────────
NESTAI_TEST_DATABASE_URL=
TEST_POSTGRES_URL=
NESTAI_BROWSER_DATABASE_URL=
NESTAI_PROVIDER_MODE=live
NESTAI_DISABLE_EMAIL=true

# ── Email (feedback notifications) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FEEDBACK_EMAIL=feedback@example.com

# ── Beta access ───────────────────────────────────────────────────────────────
# Comma-separated list of valid beta invite codes.
# Used by the legacy Streamlit app (st.secrets BETA_CODES).
BETA_CODES=
